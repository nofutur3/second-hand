# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=secondhand
DB_PASSWORD=secondhand_dev
DB_NAME=secondhand
DB_SSLMODE=disable

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=recipient@example.com

# Scraping Configuration
SCRAPE_DELAY_MS=2000
REQUEST_TIMEOUT_SEC=30

# eBay Browse API (developer.ebay.com app credentials)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_API_BASE=https://api.ebay.com

# Telegram bot (via @BotFather) for good-offer notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# Delivery address used to resolve real eBay shipping costs/currency (Browse
# API's X-EBAY-C-ENDUSERCTX contextualLocation)
EBAY_SHIP_TO_COUNTRY=CZ
EBAY_SHIP_TO_POSTAL_CODE=58601

# Shared password gating the whole app (HTTP Basic Auth, both frontend and
# API - see cmd/api's basicAuthMiddleware and server/middleware/auth.ts).
# Empty/unset disables the check.
APP_PASSWORD=
